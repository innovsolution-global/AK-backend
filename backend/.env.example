# ---------------------------------------------------------------------------
# AK IMMO — backend. Copier en .env et renseigner. Ne jamais committer le .env.
# Toutes ces variables sont validées au démarrage (config/env.validation.ts) :
# l'application refuse de démarrer si l'une d'elles est absente ou invalide.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api

# --- Base de données -------------------------------------------------------
DATABASE_URL=postgresql://ak_immo:change_me_in_local_env@localhost:5432/ak_immo?schema=public

# --- JWT -------------------------------------------------------------------
# Générer des secrets distincts et aléatoires :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=remplacer_par_un_secret_aleatoire_de_48_octets_minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=remplacer_par_un_autre_secret_aleatoire_distinct
JWT_REFRESH_EXPIRES_IN=7d
# Optionnel : signe les liens Google Earth publics (.kml) remis aux bénéficiaires.
# S'il est absent, une clé distincte est dérivée de JWT_REFRESH_SECRET.
# EARTH_LINK_SECRET=

# --- Sécurité --------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL=300
AUTH_THROTTLE_LIMIT=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Stockage objet (S3 / MinIO) -------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ak-immo
S3_ACCESS_KEY=ak_immo_minio
S3_SECRET_KEY=change_me_in_local_env
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL=300

# --- Upload ----------------------------------------------------------------
MAX_FILE_SIZE_MB=50
MAX_GEO_FILE_SIZE_MB=25

# --- Email ------------------------------------------------------------------
# Développement : Mailpit attrape tous les messages sur cette machine, rien ne
# part vers Internet. Interface : http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=AK IMMO
MAIL_FROM_ADDRESS=no-reply@ak-immo.local

# Envoi réel par Gmail — les destinataires reçoivent vraiment les invitations.
# Prérequis : validation en deux étapes activée, puis un « mot de passe
# d'application » de 16 caractères créé sur https://myaccount.google.com/apppasswords
# (à coller sans les espaces). Gmail réécrit l'expéditeur : MAIL_FROM_ADDRESS
# doit être la même adresse que SMTP_USER.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false          # 465 + true si le port 587 est bloqué
#   SMTP_USER=votre.adresse@gmail.com
#   SMTP_PASSWORD=motdepasseapplication
#   MAIL_FROM_ADDRESS=votre.adresse@gmail.com
# Vérification : npm run mail:check -- votre.adresse@gmail.com
#
# Limite Gmail : ~500 messages par jour. Au-delà, ou pour un envoi
# professionnel, passer par un service dédié (Brevo, Mailgun, SES).

# --- Application -----------------------------------------------------------
APP_NAME=AK IMMO
FRONTEND_URL=http://localhost:5173
SHARE_DEFAULT_DAYS=30
SHARE_EXPIRY_WARNING_DAYS=7
PERMIT_EXPIRY_WARNING_DAYS=30

# --- Seed de développement (§37) -------------------------------------------
# Utilisé uniquement par `npm run seed`. Jamais de données réelles.
SEED_ADMIN_EMAIL=admin@ak-immo.local
SEED_ADMIN_PASSWORD=ChangeMoi!2026
