# ---------------------------------------------------------------------------
# AK IMMO — variables utilisées par docker-compose (développement local)
# Copier en .env puis adapter. Ne jamais committer le .env.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=ak-immo

# PostgreSQL
POSTGRES_USER=ak_immo
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=ak_immo
POSTGRES_PORT=5432

# MinIO (stockage objet S3 compatible)
MINIO_ROOT_USER=ak_immo_minio
MINIO_ROOT_PASSWORD=change_me_in_local_env
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=ak-immo

# Mailpit (capture SMTP de développement)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Ports applicatifs
BACKEND_PORT=3000
FRONTEND_PORT=5173
